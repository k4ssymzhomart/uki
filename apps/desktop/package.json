{
  "name": "desktop",
  "productName": "Üki",
  "version": "0.0.0",
  "description": "Üki student app",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "build:e2e": "electron-vite build --mode e2e",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --config electron-builder.yml",
    "dist:lab": "electron-vite build --mode lab && electron-builder --config electron-builder.lab.yml --win zip --x64",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p src/renderer && tsc --noEmit -p test",
    "test": "vitest run",
    "e2e": "electron-vite build --mode e2e && playwright test -c test/playwright.config.ts",
    "e2e:cleanup": "tsx test/support/cleanup.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@uki/contracts": "workspace:*",
    "@uki/db": "workspace:*",
    "@uki/detection": "workspace:*",
    "@uki/i18n": "workspace:*",
    "@uki/tokens": "workspace:*",
    "@uki/ui": "workspace:*",
    "@xstate/react": "^6.1.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "use-intl": "^4.14.9",
    "ws": "^8.22.0",
    "xstate": "^5.33.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@uki/config": "workspace:*",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
