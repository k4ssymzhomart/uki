{
  "name": "uki",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "turbo run build",
    "check": "biome check . && pnpm guards && turbo run typecheck test && pnpm typecheck:functions && pnpm typecheck:scripts && pnpm typecheck:e2e && vitest run -c vitest.integration.config.ts --project functions-unit && pnpm test:scripts",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "guards": "tsx scripts/guards/index.ts",
    "format": "biome check --write .",
    "tokens": "pnpm --filter @uki/tokens build",
    "i18n:build": "pnpm --filter @uki/i18n build",
    "i18n:export": "tsx packages/i18n/scripts/export.ts",
    "i18n:import": "tsx packages/i18n/scripts/import.ts",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > packages/db/src/database.types.ts",
    "db:test": "supabase test db",
    "functions:sync": "tsx scripts/sync-contracts.ts",
    "functions:serve": "pnpm functions:sync && supabase functions serve --env-file supabase/functions/local.env",
    "test:integration": "(tsx scripts/sync-contracts.ts --check || pnpm functions:sync) && vitest run -c vitest.integration.config.ts",
    "test:integration:desktop": "pnpm --filter desktop exec vitest run -c src/renderer/test/vitest.stack.config.mjs",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:load": "playwright test -c e2e/simulate/playwright.config.ts",
    "supabase:deploy": "pnpm functions:sync && supabase db push && supabase functions deploy",
    "seed:staff": "tsx scripts/seed-staff.ts",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "demo:simulate": "tsx scripts/demo-simulate.ts",
    "typecheck:functions": "(tsx scripts/sync-contracts.ts --check || pnpm functions:sync) && tsc --noEmit -p supabase/functions/tsconfig.json && tsc --noEmit -p test/integration/tsconfig.json",
    "typecheck:scripts": "tsc --noEmit -p scripts/lib/tsconfig.json",
    "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "test:scripts": "vitest run -c scripts/lib/vitest.config.ts",
    "env:local": "tsx scripts/lib/local-env.ts",
    "models": "pnpm --filter @uki/detection models",
    "models:verify": "pnpm --filter @uki/detection models:verify",
    "release:assets": "tsx scripts/release-assets.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.63.0",
    "@react-email/body": "0.3.0",
    "@react-email/button": "0.2.1",
    "@react-email/column": "0.0.14",
    "@react-email/container": "0.0.16",
    "@react-email/head": "0.0.13",
    "@react-email/html": "0.0.12",
    "@react-email/img": "0.0.12",
    "@react-email/link": "0.0.13",
    "@react-email/preview": "0.0.14",
    "@react-email/render": "2.1.0",
    "@react-email/row": "0.0.13",
    "@react-email/section": "0.0.17",
    "@react-email/text": "0.1.6",
    "@supabase/supabase-js": "^2.117.2",
    "@types/node": "^24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@uki/config": "workspace:*",
    "dotenv": "^18.0.6",
    "lefthook": "^2.1.17",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  }
}
