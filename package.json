{
  "name": "uki",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "turbo run build",
    "check": "biome check . && turbo run typecheck test && pnpm typecheck:functions && vitest run -c vitest.integration.config.ts --project functions-unit",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "tokens": "pnpm --filter @uki/tokens build",
    "i18n:build": "pnpm --filter @uki/i18n build",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > packages/db/src/database.types.ts",
    "db:test": "supabase test db",
    "functions:sync": "tsx scripts/sync-contracts.ts",
    "functions:serve": "pnpm functions:sync && supabase functions serve",
    "test:integration": "(tsx scripts/sync-contracts.ts --check || pnpm functions:sync) && vitest run -c vitest.integration.config.ts",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "supabase:deploy": "pnpm functions:sync && supabase db push && supabase functions deploy",
    "seed:staff": "tsx scripts/seed-staff.ts",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "demo:simulate": "tsx scripts/demo-simulate.ts",
    "typecheck:functions": "tsc --noEmit -p supabase/functions/tsconfig.json && tsc --noEmit -p test/integration/tsconfig.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.63.0",
    "@supabase/supabase-js": "^2.117.2",
    "@types/node": "^24.19.1",
    "@uki/config": "workspace:*",
    "dotenv": "^18.0.6",
    "lefthook": "^2.1.17",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  }
}
