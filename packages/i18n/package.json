{
  "name": "@uki/i18n",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./app-config": {
      "types": "./src/app-config.d.ts"
    },
    "./messages/*": "./messages/*",
    "./catalog.json": "./catalog.json",
    "./dashboard.json": "./dashboard.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "build": "tsx scripts/build.ts",
    "build:check": "tsx scripts/build.ts --check"
  },
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "^3.5.21",
    "use-intl": "^4.14.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@uki/config": "workspace:*",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
