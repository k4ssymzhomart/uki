# Copy to .env and fill in. Never commit .env.
# Local values come from `supabase status -o env` after `supabase start`: run `pnpm env:local` to write
# them (and a generated SEED_STAFF_PASSWORD) into .env; it creates .env from this file if there is none.

# Supabase project (cloud: Project Settings > API keys; local: `pnpm env:local`, from supabase status)
SUPABASE_URL=http://127.0.0.1:54721
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key: scripts only (seed-staff, demo-reset, demo-simulate). Never in an app.
SUPABASE_SECRET_KEY=sb_secret_...

# Web dashboard (apps/web)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54721
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Desktop app build variables (apps/desktop)
VITE_SUPABASE_URL=http://127.0.0.1:54721
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# The exam office address on 2.1d Exam ended (catalog key ended.contact); the line is hidden when unset
VITE_EXAM_OFFICE_EMAIL=exams@kru.test
# Development builds only: allow screen capture for evidence videos
UKI_ALLOW_CAPTURE=0

# Üki Lock: fixed extension id (public key, base64 DER). Private key stays on your laptop.
LOCK_DEV_PUBLIC_KEY=
# The extension id derived from LOCK_DEV_PUBLIC_KEY; the app accepts only this origin
VITE_LOCK_EXTENSION_ID=

# Seed scripts
SEED_STAFF_PASSWORD=
SEED_LMS_URL=http://localhost:5180

# Cloud deploy (GitHub secrets in CI). Keep these commented out locally: an empty
# SUPABASE_DB_PASSWORD makes the Supabase CLI send an empty password to the local database.
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_DB_PASSWORD=
# SUPABASE_PROJECT_REF=

# No Next.js telemetry (CLAUDE.md: no third-party analytics)
NEXT_TELEMETRY_DISABLED=1
