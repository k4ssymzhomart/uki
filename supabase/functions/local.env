# Environment of `pnpm functions:serve` (and so of `pnpm dev` and CI's stack job): no real email leaves
# a local run. Every Resend call goes to the stub the integration tests start on this port
# (test/integration/resend-stub.ts); with nothing listening, send-invites marks its invites failed.
# Nothing here is secret: the key is a placeholder the stub accepts. The cloud project sets the real
# values with `supabase secrets set` (docs/runbooks/cloud-setup.md).
RESEND_BASE_URL=http://host.docker.internal:54790
RESEND_API_KEY=local-stub
UKI_WEB_URL=http://localhost:3000
